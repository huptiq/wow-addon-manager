<Window x:Class="HupAddonManager.App.Views.AddAddonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindow}"
        Title="Add AddOn" Width="640" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="HeaderText" Text="Add an AddOn" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="Paste a link from GitHub, CurseForge, Wago Addons, WoWInterface, GitLab, Tukui, WowUp - or a direct link to a .zip file." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LinkBox" KeyDown="LinkBox_KeyDown" />
            <Button x:Name="LookupButton" Grid.Column="1" Content="Look up" Margin="8,0,0,0" Click="Lookup_Click" />
        </Grid>
        <CheckBox x:Name="BetaBox" Content="Include beta / alpha versions" Margin="0,10,0,0" Click="BetaBox_Click" />

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed" />

        <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ByText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource Muted}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Latest version" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                    <TextBlock x:Name="VersionText" Grid.Column="1" Margin="0,2" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="File" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                    <TextBlock x:Name="FileText" Grid.Row="1" Grid.Column="1" Margin="0,2" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="Game client" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                    <TextBlock x:Name="FlavorText" Grid.Row="2" Grid.Column="1" Margin="0,2" TextWrapping="Wrap" />
                </Grid>
                <Expander x:Name="ChangelogExpander" Header="Changelog" Foreground="{StaticResource Muted}" Margin="0,10,0,0">
                    <TextBox x:Name="ChangelogText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                             VerticalScrollBarVisibility="Auto" FontSize="12" Margin="0,6,0,0" />
                </Expander>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0"
                    IsEnabled="False" Click="Install_Click" />
        </StackPanel>
    </StackPanel>
</Window>
