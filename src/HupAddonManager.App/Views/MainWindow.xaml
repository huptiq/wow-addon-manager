<Window x:Class="HupAddonManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HupAddonManager.App.ViewModels"
        Style="{StaticResource DarkWindow}"
        Title="{Binding AppTitle}" Icon="/Assets/app.ico"
        Width="1140" Height="740" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppTitle}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="Addon updater for World of Warcraft: Forever" /> <Run Text="·" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Game client" Style="{StaticResource MutedText}" Margin="2,0,0,3" />
                    <ComboBox Width="240" ItemsSource="{Binding Flavors}" SelectedItem="{Binding SelectedFlavor}"
                              IsEnabled="{Binding HasWow}" ToolTip="{Binding WowPathText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2A2414" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1" Padding="18,8"
                Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Update now" Style="{StaticResource SmallPrimaryButton}" Command="{Binding ApplyAppUpdateCommand}" />
                <TextBlock Text="{Binding AppUpdateText}" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="AddOns">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="16,14,16,10" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddAddonCommand}" ToolTip="Install an addon from a link">
                                <TextBlock Text="＋  Add AddOn" Foreground="#1A1A1A" />
                            </Button>
                            <Button Margin="8,0,0,0" Command="{Binding CheckAllCommand}" IsEnabled="{Binding HasWow}" ToolTip="Ask every source for its latest version">
                                <TextBlock Text="⟳  Check for updates" />
                            </Button>
                            <Button Margin="8,0,0,0" Command="{Binding UpdateAllCommand}" IsEnabled="{Binding HasWow}" ToolTip="Install all available updates (pinned addons are skipped)">
                                <TextBlock>
                                    <Run Text="⬆  Update all" />
                                    <Run Text="{Binding UpdateCount, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{StaticResource Orange}" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Grid Width="230">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" />
                                <TextBlock Text="⌕" Margin="11,0,0,1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False" FontSize="15" />
                                <TextBlock Text="Search addons" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="ShareButton" Margin="8,0,0,0" Click="ShareButton_Click" IsEnabled="{Binding HasWow}" ToolTip="Share your addon list, import a list, or take over WowUp's sources">
                                <TextBlock Text="Share / Import  ▾" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0,16,6" Margin="0,0,0,0">
                        <Grid Margin="0,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADDON" Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="1" Text="INSTALLED" Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="2" Text="LATEST" Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="3" Text="SOURCE" Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource ColHeader}" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="AddonList" Grid.Row="2" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                             VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="AddonList_MouseDoubleClick"
                             ContextMenuOpening="AddonList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AddonRowViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="128" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠ " Foreground="{StaticResource Orange}" ToolTip="{Binding IncompatibleTip}"
                                                       Visibility="{Binding ShowIncompatible, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FoldersText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                   ToolTip="{Binding Subtitle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" Style="{StaticResource Cell}" ToolTip="{Binding InstalledVersion}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LatestVersion}" Style="{StaticResource Cell}" ToolTip="{Binding LatestVersion}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SourceName}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Pill}" Background="{Binding StatusBackground}" ToolTip="{Binding StatusTip}">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text=" 📌" ToolTip="Pinned - won't be updated" VerticalAlignment="Center"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text=" β" ToolTip="Gets beta / alpha versions" VerticalAlignment="Center" Foreground="{StaticResource Blue}" FontWeight="Bold"
                                                   Visibility="{Binding IsBeta, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="{Binding ActionText}" Style="{StaticResource SmallPrimaryButton}" MinWidth="76"
                                                Visibility="{Binding IsPrimaryAction, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.RowPrimaryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="{Binding ActionText}" Style="{StaticResource SmallButton}" MinWidth="76">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{x:Static vm:SecondaryActionVisibility.Instance}">
                                                    <Binding Path="HasAction" />
                                                    <Binding Path="IsPrimaryAction" />
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Button.Command>
                                                <Binding Path="DataContext.RowPrimaryCommand" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </Button.Command>
                                            <Button.CommandParameter>
                                                <Binding />
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Content="⋯" Style="{StaticResource GhostButton}" FontSize="16" Margin="4,0,0,0" Padding="8,0,8,3"
                                                ToolTip="More actions" Click="MoreButton_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No addons yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,14" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="Click 'Add AddOn' and paste a link from GitHub, CurseForge, Wago, WoWInterface ...&#x0a;or import a list a friend shared with you." />
                        <Button Content="＋  Add AddOn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Command="{Binding AddAddonCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Search">
                <Grid DataContext="{Binding Search}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,14,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="AddonSearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="⌕" Margin="11,0,0,1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False" FontSize="15" />
                            <TextBlock Text="Search addons by name, author or description" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddonSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}">
                            <TextBlock Text="Search" Foreground="#1A1A1A" />
                        </Button>
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="16,2,16,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding OnlyForFlavor}" Content="{Binding OnlyForFlavorLabel}" />
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <ListBox ItemsSource="{Binding Results}" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SearchRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Background="#264CC38A" ToolTip="{Binding FlavorTip}"
                                                            Visibility="{Binding IsForFlavor, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding FlavorBadge}" Foreground="{StaticResource Green}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Background="#265AA9F7"
                                                            Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Installed" Foreground="{StaticResource Blue}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Byline}" Style="{StaticResource MutedText}" Margin="0,1,0,0" />
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="36"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Summary}"
                                                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CategoryText}" />
                                                <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Page" Style="{StaticResource SmallButton}" Margin="0,0,6,0" ToolTip="Open the addon's page in your browser"
                                                        Command="{Binding DataContext.Search.OpenPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="{Binding InstallText}" Style="{StaticResource SmallPrimaryButton}" MinWidth="80"
                                                        Command="{Binding DataContext.Search.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ProgressBar VerticalAlignment="Top" Height="2" IsIndeterminate="True"
                                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3" Text="{Binding SourcesText}" Style="{StaticResource MutedText}" Margin="16,6,16,8" TextTrimming="CharacterEllipsis"
                               ToolTip="Results per source. CurseForge search needs a free API key (Settings)." />
                </Grid>
            </TabItem>

            <TabItem Header="Backups">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,8" MaxWidth="980" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Open backup folder" Style="{StaticResource SmallButton}" Command="{Binding Backups.OpenBackupFolderCommand}" />
                                    <TextBlock Text="AddOn backups" Style="{StaticResource SectionTitle}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="A copy of the old files is saved automatically before every update, uninstall or restore. Restoring pins the addon so it isn't updated again right away." />
                                <TextBlock Text="No addon backups yet." Margin="0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Backups.AddonBackups.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Backups.AddonBackups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BackupRow}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Folders}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding When}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <Button Content="Restore" Style="{StaticResource SmallButton}"
                                                                Command="{Binding DataContext.Backups.RestoreAddonCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Foreground="{StaticResource Muted}"
                                                                Command="{Binding DataContext.Backups.DeleteAddonBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Back up now" Style="{StaticResource SmallPrimaryButton}" Command="{Binding Backups.BackupWtfNowCommand}" />
                                    <TextBlock Text="Addon settings (WTF folder)" Style="{StaticResource SectionTitle}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="The WTF folder holds all addon settings (SavedVariables), keybinds and macros. It's backed up before each batch of updates, so a broken update can't wipe your setup." />
                                <TextBlock Text="No settings backups yet.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Backups.WtfBackups.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Backups.WtfBackups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WtfRow}">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding When}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="Restore" Style="{StaticResource SmallButton}"
                                                                Command="{Binding DataContext.Backups.RestoreWtfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Foreground="{StaticResource Muted}"
                                                                Command="{Binding DataContext.Backups.DeleteWtfBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Settings" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Red}" Margin="6,0,0,0" VerticalAlignment="Top"
                                 ToolTip="Action needed: add a free CurseForge API key"
                                 Visibility="{Binding Settings.NeedsCurseForgeKey, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,8" MaxWidth="820" HorizontalAlignment="Left" DataContext="{Binding Settings}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="World of Warcraft folder" Style="{StaticResource SectionTitle}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Auto-detect" Margin="8,0,0,0" Command="{Binding DetectWowCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Command="{Binding BrowseWowCommand}" />
                                    <TextBox Text="{Binding WowRoot, Mode=OneWay}" IsReadOnly="True" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="The folder that contains _forever_ (and maybe _retail_, _classic_ ...). Pick the game client at the top right." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                                <CheckBox IsChecked="{Binding AutoUpdate}" Content="Install updates automatically (otherwise you only get a notification)" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                    <TextBlock Text="Check for updates while running:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Width="190" ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding BackupWtf}" Content="Back up addon settings (WTF folder) before installing updates" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Keep" VerticalAlignment="Center" />
                                    <TextBox Width="48" Margin="8,0" Text="{Binding AddonBackupsToKeep, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="backups per addon, and" VerticalAlignment="Center" />
                                    <TextBox Width="48" Margin="8,0" Text="{Binding WtfBackupsToKeep, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="settings (WTF) backups" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Windows" Style="{StaticResource SectionTitle}" />
                                <CheckBox IsChecked="{Binding StartWithWindows}">
                                    <TextBlock TextWrapping="Wrap" Text="Start with Windows - runs quietly in the tray and updates your addons right after the PC boots" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ExitAfterBootUpdate}" Margin="28,4,0,4" IsEnabled="{Binding StartWithWindows}"
                                          Content="Close again after the boot update (don't stay in the tray)" />
                                <CheckBox IsChecked="{Binding CloseToTray}" Content="Closing the window keeps the manager running in the tray" />
                                <CheckBox IsChecked="{Binding ShowNotifications}" Content="Show Windows notifications (updates installed, errors)" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="API keys" Style="{StaticResource SectionTitle}" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Red}" Margin="6,0,0,0" VerticalAlignment="Top"
                                             Visibility="{Binding NeedsCurseForgeKey, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="A free CurseForge API key is needed to search CurseForge, and makes CurseForge updates more reliable (without it a free mirror is used). The Wago key and GitHub token are optional: a GitHub token raises GitHub's limit of 60 checks per hour. Keys are stored encrypted for your Windows user only." />
                                <Border Background="#26EF4444" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                        Visibility="{Binding NeedsCurseForgeKey, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}"
                                               Text="Action needed: add your CurseForge API key. Click 'Get a key', sign in, copy the key from 'API keys', paste it below and click 'Save keys'. It's free." />
                                </Border>
                                <Border Background="#26F59E0B" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}"
                                               Text="Wago Addons: searching works without a key (we read the public website). Addons found on Wago are installed and updated from the source their Wago page links to, like GitHub or CurseForge. Addons that are only on Wago need a paid Wago Patreon API key - normal (free) Wago keys are rejected with error 401." />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="CurseForge API key" />
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource Red}" Margin="5,0,0,0" VerticalAlignment="Top"
                                                 Visibility="{Binding NeedsCurseForgeKey, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <PasswordBox x:Name="CurseKeyBox" Grid.Column="1" Margin="0,4" />
                                    <Button Grid.Column="2" Content="Get a key" Style="{StaticResource GhostButton}" Foreground="{StaticResource Blue}" Margin="6,0,0,0"
                                            Command="{Binding OpenUrlCommand}" CommandParameter="https://console.curseforge.com/" />
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" ToolTip="Only paid Wago Patreon API keys work">
                                        <TextBlock Text="Wago key (Patreon)" />
                                        <TextBlock Text="optional" Style="{StaticResource MutedText}" FontSize="11" />
                                    </StackPanel>
                                    <PasswordBox x:Name="WagoKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,4" ToolTip="Only paid Wago Patreon API keys work. Free keys are rejected (401)." />
                                    <Button Grid.Row="1" Grid.Column="2" Content="Patreon key" Style="{StaticResource GhostButton}" Foreground="{StaticResource Blue}" Margin="6,0,0,0"
                                            Command="{Binding OpenUrlCommand}" CommandParameter="https://addons.wago.io/patreon" />
                                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                        <TextBlock Text="GitHub token" />
                                        <TextBlock Text="optional" Style="{StaticResource MutedText}" FontSize="11" />
                                    </StackPanel>
                                    <PasswordBox x:Name="GitHubKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="Create one" Style="{StaticResource GhostButton}" Foreground="{StaticResource Blue}" Margin="6,0,0,0"
                                            Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/settings/personal-access-tokens/new" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Save keys" Style="{StaticResource PrimaryButton}" Click="SaveKeys_Click" />
                                    <TextBlock Text="Leave a box empty and save to remove that key." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="App updates &amp; files" Style="{StaticResource SectionTitle}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Check now" Margin="8,0,0,0" Command="{Binding CheckAppUpdateCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Project page" Margin="8,0,0,0" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding RepoUrl}" />
                                    <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" />
                                </DockPanel>
                                <CheckBox IsChecked="{Binding CheckForAppUpdates}" Content="Check for new versions of the manager on start" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding AppUpdateNote}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                                    <Button Content="Open today's log" Margin="8,0,0,0" Command="{Binding OpenLogCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SavedNote}" Foreground="{StaticResource Green}" Margin="2,0,0,16" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Log">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="2">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <TextBlock Text="{Binding}" Padding="8,1" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open log file" Command="{Binding Settings.OpenLogCommand}" />
                        <Button Content="Open AddOns folder" Margin="8,0,0,0" Command="{Binding OpenAddOnsFolderCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <ProgressBar VerticalAlignment="Top" Height="2" Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}"
                             Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
                <DockPanel Margin="16,7">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryText}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
